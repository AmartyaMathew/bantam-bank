# Copying this file by hand is supported, but ./prepare.sh is safer: it creates
# the independent application secrets and the matching internal certificates.
BANTAM_DOMAIN=bantam.example.com
ACME_EMAIL=operator@example.com
BANTAM_IMAGE_TAG=local
BANTAM_API_IMAGE=bantam-api:local
BANTAM_WEB_IMAGE=bantam-web:local

POSTGRES_PASSWORD=
NATS_PASSWORD=
NATS_JETSTREAM_KEY=
JWT_SECRET=
SCA_SECRET=
CLAIMS_SECRET=
MFA_ENCRYPTION_KEY=

# Optional. The Mistral key enables repository reading guides and attack trees.
# The GitHub token is needed only for private repository sources; make it a
# fine-grained, read-only Contents token restricted to the required repositories.
ASPIS_MISTRAL_API_KEY=
WORKFLOW_GITHUB_TOKEN=

# Optional. Matching BANK_ADMIN email is treated as super admin for scoped RBAC.
BANTAM_SUPER_ADMIN_EMAIL=
